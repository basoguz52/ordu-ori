# === Uygulama config'i (backend/.env) ===
# Bu dosya uygulamanın gerçek config kaynağıdır. `cp backend/.env.example backend/.env`
# yapıp doldur. `backend/.env` repoya/commit'e girmemeli, FTP'de overwrite edilmemeli.
#
# Docker'da bu değerler docker-compose tarafından ortam değişkeni olarak set edilir;
# yani local'de backend/.env olmadan da çalışır. Canlıda (cPanel) bu dosyayı doldur.

APP_ENV=production

# --- Veritabanı ---
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=orienteering
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- CORS (virgülle ayrılmış izinli origin listesi) ---
CORS_ALLOWED_ORIGINS=https://orduoryantiring.com.tr,https://www.orduoryantiring.com.tr

# --- SMTP (iletişim formu) ---
MAIL_DEBUG=false
SMTP_HOST=mail.orduoryantiring.com.tr
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=destek@orduoryantiring.com.tr
SMTP_PASS=
MAIL_TO=oryantiringordu@gmail.com
MAIL_FROM=destek@orduoryantiring.com.tr
MAIL_FROM_NAME="Destek Ordu Oryantiring"
