  "item": [
    {
      "name": "00 Auth & Session",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.response.code === 200);",
              "pm.test('is admin', () => pm.response.json().user.is_admin === true);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_pass}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api","login"] }
          }
        },
        {
          "name": "Get Me (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/me", "host": ["{{base_url}}"], "path": ["api","me"] }
          }
        },
        {
          "name": "Register (new pending user)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "pm.collectionVariables.set('reg_email', 'kayit_' + Date.now() + '@local.test');"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('201 created', () => pm.response.code === 201);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Yeni Yonetici\",\n  \"email\": \"{{reg_email}}\",\n  \"password\": \"Parola123\",\n  \"phone_number\": \"05551112233\"\n}" },
            "url": { "raw": "{{base_url}}/api/register", "host": ["{{base_url}}"], "path": ["api","register"] }
          }
        },
        {
          "name": "Login as Pending (expect 403)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('403 account_pending', () => pm.response.code === 403);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{reg_email}}\",\n  \"password\": \"Parola123\"\n}" },
            "url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api","login"] }
          }
        }
      ]
    },
    {
      "name": "01 Admin: User Approval",
      "item": [
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_pass}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api","login"] }
          }
        },
        {
          "name": "List Pending Users",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const j = pm.response.json();",
              "const target = j.items.find(x => x.email === pm.collectionVariables.get('reg_email')) || j.items[0];",
              "if (target) pm.collectionVariables.set('pending_user_id', target.id);",
              "pm.test('has pending', () => j.items.length >= 0);"
            ] } }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/admin/users?status=pending", "host": ["{{base_url}}"], "path": ["api","admin","users"], "query": [ { "key": "status", "value": "pending" } ] }
          }
        },
        {
          "name": "Approve User (make club manager + new club)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 approved', () => pm.response.code === 200);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"is_club_manager\": true,\n  \"club_name\": \"Test Onay Kulubu\",\n  \"club_code\": \"TOK\"\n}" },
            "url": { "raw": "{{base_url}}/api/admin/users/{{pending_user_id}}/approve", "host": ["{{base_url}}"], "path": ["api","admin","users","{{pending_user_id}}","approve"] }
          }
        },
        {
          "name": "List Active Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/admin/users?status=active", "host": ["{{base_url}}"], "path": ["api","admin","users"], "query": [ { "key": "status", "value": "active" } ] }
          }
        }
      ]
    },
    {
