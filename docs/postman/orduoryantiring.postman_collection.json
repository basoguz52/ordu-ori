      "item": [
        {
          "name": "List Clubs",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/clubs", "host": ["{{base_url}}"], "path": ["api","clubs"] } }
        },
        {
          "name": "List Categories",
          "event": [
